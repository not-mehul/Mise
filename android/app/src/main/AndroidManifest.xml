<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mise needs the network only to fetch a recipe page you share with it;
         everything else works offline, photo text recognition included. No
         storage or camera permissions:
         backups go to Documents/ (app-created files) and the share sheet,
         and photos come from the system picker or camera app. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cooking timers ring like an alarm at the moment they end, with the
         screen off or another app open (TimerAlarmPlugin). Local
         Notifications adds POST_NOTIFICATIONS (asked for on the first timer)
         and SCHEDULE_EXACT_ALARM; USE_EXACT_ALARM keeps them exact on
         Android 13 and later without sending you to the "Alarms & reminders"
         screen, because timers are what cooking mode is for. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Auto Backup (Google account) copies the recipe library, which lives
         in the WebView's IndexedDB. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- singleTask: a link or something shared in reaches the running
             page rather than starting a second WebView (style.md §14.1). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- mise:// links from the other apps (style.md §14.1), read by
                 src/platform/incoming.ts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mise" />
            </intent-filter>
            <!-- "Share to Mise": a link or caption, or photos of a recipe
                 (ShareIntakePlugin). Nothing is saved until Save recipe. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Recipe files sent or opened with Mise: a Mise backup or shared
                 recipe, a Paprika export, schema.org JSON (src/import/files.ts).
                 Opening one shows what it holds before anything is saved. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

        </activity>

        <!-- Rings a kitchen timer at the moment it ends (TimerAlarmPlugin). -->
        <receiver
            android:name=".TimerAlarmReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Lets the app ask whether a sibling app is installed before handing
         off to it (style.md §14.1). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="waymark" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bookshelf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="ledger" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="colophon" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="rosetta" />
        </intent>
    </queries>
</manifest>
